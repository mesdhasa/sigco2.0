# SIGCO - regles Apache (AUDIT-006, AUDIT-009, AUDIT-010)

# Pas de listing des dossiers
Options -Indexes

# Fichiers caches (.git, .ftpconfig, .env, .htaccess...) : jamais servis
<IfModule mod_rewrite.c>
	RewriteEngine on
	RewriteRule (^|/)\. - [F,L]
</IfModule>

# Fichiers sensibles ou techniques a la racine : jamais servis
<FilesMatch "(?i)^(composer\.(json|lock)|README\.md|www|.*\.(sql|sql\.gz|bak|old|orig|log|ini|sh|md|lock|dist)|.*\.php[0-9]+)$">
	<IfModule authz_core_module>
		Require all denied
	</IfModule>
	<IfModule !authz_core_module>
		Deny from all
	</IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
	# Dossiers internes : jamais servis directement
	RewriteRule ^(application|system|cron|test|sql|docs)(/|$) - [F,L]

	# HTTPS force si le serveur a defini SIGCO_FORCE_HTTPS (facultatif : la redirection est aussi faite par PHP si force_https = TRUE dans env.php)
	RewriteCond %{ENV:SIGCO_FORCE_HTTPS} =1
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !=https
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

	# Front controller CodeIgniter
	RewriteCond $1 !^(index\.php|resources|robots\.txt)
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

# Scripts PHP dans assets/ : jamais executes, sauf le generateur de code-barres
# en lecture seule utilise par les etiquettes (assets/images/cb.php).
# assets/barcode/barcode.php permettait d'ecrire un fichier n'importe ou (parametre filepath).
<IfModule mod_rewrite.c>
	RewriteCond %{REQUEST_URI} !/assets/images/cb\.php$
	RewriteRule ^assets/.*\.(php[0-9]?|phtml|phar)$ - [F,L,NC]
</IfModule>

# Ne pas annoncer la version de PHP
<IfModule mod_headers.c>
	Header always unset X-Powered-By
	Header unset X-Powered-By
</IfModule>

# Rapidite : fichiers statiques gardes 30 jours par le navigateur (les fichiers propres a SIGCO
# sont appeles avec ?v=<date de modification> : une mise a jour est rechargee immediatement).
<IfModule mod_headers.c>
	<FilesMatch "\.(css|js|png|jpe?g|gif|ico|svg|woff2?|ttf|eot|otf)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
</IfModule>
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css "access plus 30 days"
	ExpiresByType application/javascript "access plus 30 days"
	ExpiresByType text/javascript "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
	ExpiresByType image/jpeg "access plus 30 days"
	ExpiresByType image/gif "access plus 30 days"
	ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
# Rapidite : compression des pages, styles et scripts (3 a 5 fois moins de donnees a transferer)
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

php_value max_input_vars 10000
