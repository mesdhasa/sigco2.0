				'codetx'			=>'FAC',
				'date'				=>date('y-m-d'),
				'description'		=>'Redevance informatiques',
				'apayer'			=>'5',
				'monnaie_apayer' 	=>'USD',
				'payer'				=>'0',
				'taux'				=>'',
				'encaisse'			=>'',
				'monnaie'			=>'',
				'nofacture'			=>date('YmdHis').valeur_n_chiffres(5,0),
				'nopaiement'		=>'',
				'status'			=>'1',
				'awbl_type'    => "import",
				'norapport'			=>$this->session->numrapport,
